# Copy to .env and change for any non-local deployment.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-bytes
QR_SECRET=change-me-to-a-different-long-random-string

# Where browsers reach the API (baked into the web build).
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Hold window in seconds (default 10 minutes). Set low (e.g. 60) to demo expiry.
HOLD_SECONDS=600

# Host ports, in case 5432/6379 are taken by local installs.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
